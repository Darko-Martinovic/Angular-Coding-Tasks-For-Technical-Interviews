{
  "name": "angular-coding-tasks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "30 self-contained Angular debugging/fixing tasks (L4) as an npm workspace — one install, 60 standalone Vite apps wired with @analogjs/vite-plugin-angular.",
  "workspaces": [
    "*-Task",
    "*-Solution"
  ],
  "scripts": {
    "dev": "echo \"Run a single app: npm run dev -w 01-OnPushMutation-Task   (or: cd 01-OnPushMutation-Task && npm run dev)\" && exit 1",
    "typecheck:all": "node scripts/typecheck-all.mjs",
    "build:all": "node scripts/build-all.mjs",
    "scaffold": "node scripts/scaffold.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.2",
    "@angular/build": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.14"
  }
}
